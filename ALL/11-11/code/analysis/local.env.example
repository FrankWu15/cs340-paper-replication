# 拷成 local.env 后按本机情况填写。
# local.env 已被 .gitignore 排除，不进版本库；不填也能跑，
# 脚本会退回 PATH 里的 go，二进制放到系统临时目录。

# ---- Go 工具链 -------------------------------------------------------------
# Windows（本机实测值）
GO_MODERN="C:/gs/toolchain/go1.27.3/go/bin/go.exe"
GO_LEGACY="C:/gs/toolchain/go1.10.8/go/bin/go.exe"
BIN_DIR="C:/gs/bin"

# Linux / macOS 示例
# GO_MODERN="/usr/local/go/bin/go"
# GO_LEGACY="/usr/local/go1.10.8/bin/go"
# BIN_DIR="$HOME/.local/bin"

# ---- 大体积依赖的位置（可选）------------------------------------------------
# 默认依次找 <root>/6app、<root>/../6app
# REPO_ROOT="/path/to/6app"
# ARTIFACT_DIR="/path/to/go-concurrency-bugs-master"
